# Copiar a .env.local para desarrollo, o cargar en Vercel (Project Settings > Environment Variables).
# Todas son OPCIONALES: si no están, se usan los valores por defecto de src/config/product.ts

# Checkout de Hotmart (con order bump: ?checkoutMode=10)
# --- Guía "Salud +60" ($47, oferta Hotmart) ---
NEXT_PUBLIC_CHECKOUT_URL=https://pay.hotmart.com/J106687311E?off=sulskzog

# --- Los otros 2 planes de la sección de combo ---
# Guía "Piel Joven" ($37, oferta Hotmart)
NEXT_PUBLIC_CHECKOUT_PIEL_URL=https://pay.hotmart.com/V106784119A?off=640486df
# COMBO las 2 guías ($47) — producto ya creado en Hotmart.
NEXT_PUBLIC_CHECKOUT_COMBO_URL=https://pay.hotmart.com/L107048581S?checkoutMode=10

# Precio mostrado (sin símbolo) — Salud +60 ahora $47
NEXT_PUBLIC_PRODUCT_PRICE=47
NEXT_PUBLIC_ORIGINAL_PRICE=97

# Contacto y dominio
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@archivosfederer.com
NEXT_PUBLIC_SITE_URL=https://archivos-federer.vercel.app
